# BotFather'dan olingan token shu yerga yoziladi.
# Bu faylning nusxasini `.env` deb saqlang va o'z tokeningizni qo'ying.
BOT_TOKEN=123456789:ABCdefGhIjKlmNoPQRstuVwxyz

# Google AI Studio (aistudio.google.com/apikey) dan olingan bepul Gemini
# API key. Xabarlar ma'nosini (qaysi ovqat, +/-) aniqlash uchun ishlatiladi.
# Bo'lmasa ham bot ishlayveradi (mahalliy qoidalarga qaytadi), lekin
# erkin/g'alati yozilgan xabarlarni yomonroq tushunadi.
GEMINI_API_KEY=AIzaSy...sizning_keyingiz


# ─────────────────────────────────────────────────────────────────────────
# INSTAGRAM AGENTI (instagram/ papkasi). Batafsil: instagram/README.md
# Faqat Business/Creator (Professional) akkaunt bilan ishlaydi.
# ─────────────────────────────────────────────────────────────────────────

# Meta developer ilovasidan olingan Instagram tokeni (60 kun amal qiladi)
IG_ACCESS_TOKEN=IGQVJ...sizning_tokeningiz
IG_USER_ID=17841400000000000

# Instagram rasmni ochiq manzildan yuklab oladi. Agent o'zi HTTP server
# ko'taradi — bu yerga Render bergan manzilni yozing.
PUBLIC_BASE_URL=https://ig-agent.onrender.com
# Muqobil variant (server manzili bo'lmasa): imgbb.com dan bepul API key
# IMGBB_API_KEY=

# Sahifa haqida — post matni shu asosda yoziladi
IG_BRAND=Brend nomi
IG_TOPIC=Sahifangiz mavzusi (masalan: videokuzatuv kameralari)
IG_LANGUAGE=uz
IG_TONE=do'stona, ishonchli, professional
IG_CTA=Batafsil ma'lumot uchun Direct'ga yozing.
IG_HASHTAGS=brend,mavzu,toshkent

# Jadval (Toshkent vaqti) va kunlik chegara
IG_POST_TIMES=10:00,18:00
IG_MAX_POSTS_PER_DAY=2

# Mavzuni internetdan olish (ixtiyoriy, vergul bilan)
# IG_RSS_FEEDS=https://kun.uz/uz/news/rss,https://www.gazeta.uz/uz/rss/

# Kommentlarga avtomatik javob
IG_AUTO_REPLY=true
IG_COMMENT_POLL_MINUTES=15

# Post joylashdan oldin Telegram'da tasdiq so'rash (birinchi kunlar uchun
# tavsiya etiladi). IG_NOTIFY_CHAT_ID — @userinfobot bergan raqamingiz.
IG_REQUIRE_APPROVAL=false
# IG_NOTIFY_CHAT_ID=123456789
