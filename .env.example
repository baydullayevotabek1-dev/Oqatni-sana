# BotFather'dan olingan token shu yerga yoziladi.
# Bu faylning nusxasini `.env` deb saqlang va o'z tokeningizni qo'ying.
BOT_TOKEN=123456789:ABCdefGhIjKlmNoPQRstuVwxyz

# Google AI Studio (aistudio.google.com/apikey) dan olingan bepul Gemini
# API key. Xabarlar ma'nosini (qaysi ovqat, +/-) aniqlash uchun ishlatiladi.
# Bo'lmasa ham bot ishlayveradi (mahalliy qoidalarga qaytadi), lekin
# erkin/g'alati yozilgan xabarlarni yomonroq tushunadi.
GEMINI_API_KEY=AIzaSy...sizning_keyingiz
